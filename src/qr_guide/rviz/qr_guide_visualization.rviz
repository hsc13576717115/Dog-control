Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 95; 101; 113
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: odom
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 150
      Name: Estimated Odom
      Position Tolerance: 0.02
      Shape:
        Alpha: 0.75
        Axes Length: 0.20
        Axes Radius: 0.02
        Color: 255; 214; 102
        Head Length: 0.08
        Head Radius: 0.03
        Shaft Length: 0.15
        Shaft Radius: 0.015
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /qr_guide/estimation/odom
      Value: true
    - Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 214; 102
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.03
      Length: 0.1
      Line Style: Lines
      Line Width: 0.03
      Name: Estimated Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 85
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /qr_guide/estimation/path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /qr_guide/visualization/marker_array
      Name: Quadruped Visualization
      Namespaces:
        {}
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 27; 35
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.12
      Name: Orbit
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: odom
      Value: Orbit (rviz)
      Yaw: 1.1
Window Geometry:
  Displays:
    collapsed: false
  Height: 960
  Width: 1600
  X: 120
  Y: 60
