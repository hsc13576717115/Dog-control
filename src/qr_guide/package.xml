<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qr_guide</name>
  <version>0.0.0</version>
  <description>ROS 2 Humble port of the original Unitree guide package for the local qr_ws workspace.</description>

  <maintainer email="orangepi@example.com">orangepi</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>fdilink_ahrs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-evdev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
