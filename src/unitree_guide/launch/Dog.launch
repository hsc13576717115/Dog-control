<?xml version="1.0"?>
<launch>
    <!-- 1. FDILINK IMU驱动节点 -->
    <node pkg="fdilink_ahrs" name="ahrs_driver" type="ahrs_driver" output="screen" >
        <!-- 是否输出debug信息 -->
        <param name="debug"  value="false"/>

        <!-- 串口设备路径 -->
        <param name="port"  value="/dev/ttyUSB0"/>

        <!-- 波特率 -->
        <param name="baud"  value="921600"/>

        <!-- imu数据话题（MSG_IMU 0X40数据包） -->
        <param name="imu_topic"  value="imu"/>

        <!-- imu话题的frame_id -->
        <param name="imu_frame"  value="gyro_link"/>

        <!-- 地磁北yaw角话题（MSG_AHRS 0X41数据包） -->
        <param name="mag_pose_2d_topic"  value="/mag_pose_2d"/>

        <!-- 欧拉角话题（MSG_AHRS 0X41数据包） -->
        <param name="Euler_angles_pub_"  value="/euler_angles"/>

        <!-- 磁力计磁场强度话题（MSG_IMU 0X40数据包） -->
        <param name="Magnetic_pub_"  value="/magnetic"/>

        <!-- GPS数据话题（MSG_GEODETIC_POS 0X5C数据包） -->
        <param name="gps_topic_" value="/gps/fix"/>

        <!-- 机体系速度话题（MSG_INSGPS 0X42数据包） -->
        <param name="twist_topic_" value="/system_speed"/>

        <!-- NED系位移和速度话题（MSG_INSGPS 0X42数据包） -->
        <param name="NED_odom_topic_" value="/NED_odometry"/>

        <!-- 设备坐标系模式（1为ROS常用坐标系） -->
        <param name="device_type"  value="1"/> <!-- 0: origin_data, 1: for single imu or ucar in ROS -->
    </node>

    <!-- 2. event2joy转换节点（unitree_guide包） -->
    <node
        name="event2joy_node"
        pkg="unitree_guide" 
        type="event2joy.py"  
        output="screen"
    />

    <!-- 3. 机器人控制节点（unitree_guide包） -->
    <node
        name="unitree_junior_ctrl"
        pkg="unitree_guide"
        type="junior_ctrl"
        output="screen"
        required="true"
    />
</launch>