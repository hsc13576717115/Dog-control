<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ramp_10deg">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor><use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <model name="ramp_10deg_up">
      <static>true</static><pose>1.7386 0.0 0.1105 0 -0.174533 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.50 1.50 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.50 1.50 0.04</size></box></geometry><material><ambient>0.90 0.55 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="ramp_10deg_down">
      <static>true</static><pose>3.2158 0.0 0.1105 0 0.174533 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.50 1.50 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.50 1.50 0.04</size></box></geometry><material><ambient>0.80 0.45 0.10 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
